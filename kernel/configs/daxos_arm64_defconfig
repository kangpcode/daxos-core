# ==============================================================================
# DAXOS HYBRID OPERATING SYSTEM KERNEL CONFIGURATION (aarch64 ARMv8.4-A+)
# File: kernel/configs/daxos_arm64_defconfig
# Hardware Targets: Apple Silicon M-Series, Snapdragon X Elite, ARM64 Server
# ==============================================================================

# Target Architecture
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_PA_BITS_48=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_UAO=y
CONFIG_ARM64_MTE=y

# Rust In-Tree Infrastructure (Linux 6.12+)
CONFIG_RUST=y
CONFIG_RUST_IS_AVAILABLE=y

# Apple Silicon & Qualcomm SoC Drivers
CONFIG_ARCH_APPLE=y
CONFIG_APPLE_M1_CPU_FREQ=y
CONFIG_APPLE_DART=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_SMC=y
CONFIG_DRM_ASAHI=m
CONFIG_ARCH_QCOM=y
CONFIG_QCOM_CLK_RPMH=y

# Real-Time Scheduling & Low Latency Core
CONFIG_PREEMPT_BUILD=y
CONFIG_PREEMPT=y
CONFIG_PREEMPT_RT=y
CONFIG_PREEMPT_COUNT=y
CONFIG_HZ_1000=y
CONFIG_HZ=1000
CONFIG_NO_HZ_FULL=y
CONFIG_SCHED_CORE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# Security Hardening & Root-of-Trust (Apple SEP / ARM TrustZone)
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_INTEGRITY=y
CONFIG_LSM="landlock,lockdown,yama,bpf,ima"
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_SECURITY_KEYS=y
CONFIG_TRUSTED_KEYS=y
CONFIG_IMA=y
CONFIG_IMA_APPRAISE=y

# Cryptography (ARMv8 CE: AES-XTS, SHA3)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA3_ARM64=y
CONFIG_CRYPTO_SHA512_ARM64=y

# Storage & Filesystems (EROFS + dm-verity)
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_LZ4=y
CONFIG_EXT4_FS=y
CONFIG_BTRFS_FS=y

# Sandboxing & cgroups v2
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y

# User-Space Driver Framework (DreX-Driver) & VFIO
CONFIG_VFIO=y
CONFIG_VFIO_PCI=y
CONFIG_UIO=y
CONFIG_DMABUF_HEAPS=y
CONFIG_SYNC_FILE=y

# DRM & Display (Wayland)
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_SIMPLEDRM=y

# Low-Latency Audio Subsystem
CONFIG_SND=y
CONFIG_SND_HRTIMER=y
CONFIG_SND_DYNAMIC_MINORS=y

# Networking & BBRv3
CONFIG_NET=y
CONFIG_INET=y
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_WIREGUARD=m

# Gaming & Compatibility
CONFIG_NTSYNC=m
CONFIG_DREX_BOOST=m
CONFIG_FUTEX=y
CONFIG_BINFMT_MISC=y
CONFIG_KVM=y
CONFIG_IO_URING=y
