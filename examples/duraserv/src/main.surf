module daxos.duraserv;

component DuraServApp: Component {
    @State var isAllRunning: Bool = true;
    @State var nginxActive: Bool = true;
    @State var phpActive: Bool = true;
    @State var phpVersion: String = "8.3";
    @State var mysqlActive: Bool = true;
    @State var postgresActive: Bool = true;
    @State var redisActive: Bool = true;
    @State var nodeActive: Bool = false;
    @State var golangActive: Bool = false;
    @State var vlangActive: Bool = false;
    @State var pythonActive: Bool = false;
    @State var vhostCount: Int = 3;
    @State var statusMessage: String = "All core web services running on ports 80, 3306, 5432, 6379, 9000.";

    func toggleAll() {
        isAllRunning = !isAllRunning;
        nginxActive = isAllRunning;
        phpActive = isAllRunning;
        mysqlActive = isAllRunning;
        postgresActive = isAllRunning;
        redisActive = isAllRunning;
    }

    func toggleNginx() {
        nginxActive = !nginxActive;
    }

    func togglePhp() {
        phpActive = !phpActive;
    }

    func toggleMysql() {
        mysqlActive = !mysqlActive;
    }

    func togglePostgres() {
        postgresActive = !postgresActive;
    }

    func toggleRedis() {
        redisActive = !redisActive;
    }

    func toggleNode() {
        nodeActive = !nodeActive;
    }

    func toggleGolang() {
        golangActive = !golangActive;
    }

    func toggleVlang() {
        vlangActive = !vlangActive;
    }

    func togglePython() {
        pythonActive = !pythonActive;
    }

    func setPhpVersion(ver: String) {
        phpVersion = ver;
    }

    func body() -> ViewNode {
        return Card {
            VStack(spacing: 16) {
                HStack(spacing: 12) {
                    Text("DuraServ Web Server & Developer Environment")
                    Spacer()
                    Button("Start All", action: toggleAll)
                }
                Text(statusMessage)
            }
        };
    }
}
