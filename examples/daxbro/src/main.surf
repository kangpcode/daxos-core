module daxos.browser;

component BrowserApp: Component {
    @State var currentUrl: String = "https://daxos.org";
    @State var pageTitle: String = "DAXOS — Official Dhafa Advanced eXperience OS";
    @State var trackersBlocked: Int = 42;
    @State var isSecureHttps: Bool = true;
    @State var activeTabId: Int = 1;
    @State var acrylicBlur: Float = 30.0;
    @State var loadLatencyMs: Float = 45.2;

    func onNavigate(url: String) {
        currentUrl = url;
    }

    func selectTab(tabId: Int, url: String, title: String) {
        activeTabId = tabId;
        currentUrl = url;
        pageTitle = title;
    }

    func body() -> ViewNode {
        return Card {
            VStack(spacing: 0) {
                // Tab Strip (macOS / Chromium Native Layout)
                HStack(spacing: 6) {
                    // Tab 1
                    Box {
                        HStack(spacing: 8) {
                            Text("DAXOS Portal")
                                .font(.system(size: 11, weight: .semibold))
                                .foregroundColor(activeTabId == 1 ? "#FFFFFF" : "#94A3B8")
                            Button(title: "CLOSE", action: { })
                                .buttonStyle(.glass)
                        }
                        .padding(6)
                    }
                    .backgroundColor(activeTabId == 1 ? "#222438" : "#141622")
                    .cornerRadius(6)

                    // Tab 2
                    Box {
                        HStack(spacing: 8) {
                            Text("DapStore Hub")
                                .font(.system(size: 11, weight: .semibold))
                                .foregroundColor(activeTabId == 2 ? "#FFFFFF" : "#94A3B8")
                            Button(title: "CLOSE", action: { })
                                .buttonStyle(.glass)
                        }
                        .padding(6)
                    }
                    .backgroundColor(activeTabId == 2 ? "#222438" : "#141622")
                    .cornerRadius(6)

                    Button(title: "+ NEW", action: { })
                        .buttonStyle(.glass)

                    Spacer()

                    Text("DaxShield: " + String(trackersBlocked) + " Blocked")
                        .font(.system(size: 11, weight: .bold))
                        .foregroundColor("#30D158")
                }
                .padding(6)
                .backgroundColor("#161822")

                // Navigation Toolbar & Omnibox
                HStack(spacing: 8) {
                    Button(title: "BACK", action: { }).buttonStyle(.secondary)
                    Button(title: "FWD", action: { }).buttonStyle(.secondary)
                    Button(title: "RELOAD", action: { }).buttonStyle(.secondary)
                    Button(title: "HOME", action: { onNavigate(url: "https://daxos.org") }).buttonStyle(.secondary)

                    // Omnibox
                    Box {
                        HStack(spacing: 8) {
                            Text(isSecureHttps ? "SECURE" : "INSECURE")
                                .font(.system(size: 9, weight: .bold))
                                .foregroundColor(isSecureHttps ? "#30D158" : "#FF453A")
                            Text(currentUrl)
                                .font(.system(size: 12))
                                .foregroundColor("#FFFFFF")
                            Spacer()
                            Text("TLS 1.3 / Kyber")
                                .font(.system(size: 9, weight: .bold))
                                .foregroundColor("#00D2FF")
                        }
                        .padding(8)
                    }
                    .cornerRadius(8)
                    .backgroundColor("#262938")
                }
                .padding(8)
                .backgroundColor("#1E202C")

                // Browser Viewport
                Box {
                    VStack(alignment: .leading, spacing: 14) {
                        Text(pageTitle)
                            .font(.system(size: 22, weight: .bold))
                            .foregroundColor("#FFFFFF")

                        Text("Welcome to the next-generation micro-ecosystem.\nEngineered with hardware-accelerated DreXUI, Landlock v5 sandboxing, and atomic A/B OTA.")
                            .font(.system(size: 13))
                            .foregroundColor("#A0A0B4")

                        HStack(spacing: 12) {
                            Button(title: "Explore Documentation", action: { })
                                .buttonStyle(.accent)
                            Button(title: "DapStore Applications", action: { })
                                .buttonStyle(.secondary)
                        }

                        Spacer()

                        // Bottom Browser Security Bar
                        HStack(spacing: 14) {
                            Text("Chromium 132.0 / Blink 6.12 / V8 JIT 13.2")
                                .font(.system(size: 10, weight: .medium))
                                .foregroundColor("#888899")
                            Text("DOM Render Latency: " + String(loadLatencyMs) + " ms")
                                .font(.system(size: 10))
                                .foregroundColor("#30D158")
                            Spacer()
                            Text("Landlock LSM ABI v5: STRICT ENFORCE")
                                .font(.system(size: 10, weight: .bold))
                                .foregroundColor("#00D2FF")
                        }
                        .padding(8)
                        .backgroundColor("rgba(0,0,0,0.3)")
                        .cornerRadius(6)
                    }
                    .padding(20)
                }
                .glassEffect(opacity: 0.88, blurRadius: acrylicBlur, edgeBrightness: 1.1, noise: 0.02)
            }
        };
    }
}
