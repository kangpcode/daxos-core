# ==============================================================================
# DAXOS SYSTEMD SERVICE: BLUETOOTH & SPATIAL PERIPHERAL DAEMON (dax-bluetoothd)
# File: boot/systemd/dax-bluetoothd.service
# ==============================================================================
[Unit]
Description=DAXOS Bluetooth 5.4 Low-Energy & Spatial Peripheral Manager
Documentation=man:dnet(1)
After=network.target dax-audiod.service dap-registryd.service
PartOf=daxos.target

[Service]
Type=oneshot
RemainAfterExit=yes
Slice=daxos-system.slice
ExecStart=/usr/bin/dnet dev
StandardOutput=journal
StandardError=journal

# Security Sandboxing
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/daxos /tmp /run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE CAP_NET_RAW
NoNewPrivileges=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=daxos.target
